# Copy this file to ~/.config/herdr-web-client/env and replace each required
# value with the values for your OIDC provider and reverse proxy.
HERDR_WEB_CLIENT_LISTEN_ADDR=127.0.0.1:8080
HERDR_WEB_CLIENT_PUBLIC_ORIGIN=https://web.example.invalid
HERDR_WEB_CLIENT_OIDC_ISSUER=https://issuer.example.invalid
HERDR_WEB_CLIENT_OIDC_AUDIENCE=replace-with-oidc-audience
HERDR_WEB_CLIENT_OIDC_ASSERTION_HEADER=X-OIDC-Assertion

# Optional: set an explicit HTTPS JWKS endpoint to skip OIDC discovery.
# HERDR_WEB_CLIENT_OIDC_JWKS_URL=https://issuer.example.invalid/keys
# Optional Herdr process paths; unset to use defaults derived from $HOME.
# HERDR_WEB_CLIENT_HERDR_PATH=/absolute/path/to/herdr
# HERDR_WEB_CLIENT_HERDR_WORKDIR=/absolute/path/to/workdir
# HERDR_WEB_CLIENT_HERDR_SOCKET=/absolute/path/to/herdr.sock
