# Herdr Web does not provide authentication. Secure access separately.
# Set the exact HTTPS origin used by the browser.
HERDR_WEB_CLIENT_LISTEN_ADDR=127.0.0.1:8080
HERDR_WEB_CLIENT_PUBLIC_ORIGIN=https://web.example.invalid

# Optional Herdr process paths; unset to use defaults derived from $HOME.
# HERDR_WEB_CLIENT_HERDR_PATH=/absolute/path/to/herdr
# HERDR_WEB_CLIENT_HERDR_WORKDIR=/absolute/path/to/workdir
# HERDR_WEB_CLIENT_HERDR_SOCKET=/absolute/path/to/herdr.sock
