#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
GITLEAKS_VERSION=8.30.1

if (( $# != 0 )); then
  printf 'usage: %s\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi

gitleaks=(go run "github.com/zricethezav/gitleaks/v8@v${GITLEAKS_VERSION}")

cd -- "$ROOT"

# Scan the checked-out files and generated artifacts, including untracked files.
"${gitleaks[@]}" dir --no-banner --no-color --redact=100 --exit-code=1 "$ROOT"

# Scan every reachable commit and patch, not only the current checkout.
"${gitleaks[@]}" git --no-banner --no-color --redact=100 --exit-code=1 --log-opts=--all "$ROOT"
