#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

if (( $# > 1 )); then
  printf 'usage: %s [output]\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi

requested_output=${1:-build/herdr-web-client}
if [[ "$requested_output" = /* ]]; then
  output=$requested_output
else
  output=$ROOT/$requested_output
fi
version=${HERDR_WEB_CLIENT_VERSION:-${VERSION:-dev}}
cgo_enabled=${CGO_ENABLED:-0}

cd -- "$ROOT"
required_bun_version=1.3.14
if ! actual_bun_version=$(bun --version 2>&1); then
  printf 'unable to determine Bun version\n%s\n' "$actual_bun_version" >&2
  exit 1
fi
if [[ "$actual_bun_version" != "$required_bun_version" ]]; then
  printf 'Bun %s is required; found %s\n' "$required_bun_version" "$actual_bun_version" >&2
  exit 1
fi

mkdir -p -- "$(dirname -- "$output")"

# The browser bundle is part of the Go binary, so always regenerate it first.
HERDR_WEB_CLIENT_BUILD_DIST='' bun run build.mjs
CGO_ENABLED=$cgo_enabled go build \
  -trimpath \
  -buildvcs=false \
  -ldflags "-X main.version=$version" \
  -o "$output" \
  .

printf 'built %s (version %s)\n' "${output#"$ROOT/"}" "$version"
