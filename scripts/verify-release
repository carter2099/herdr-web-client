#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

if (( $# != 2 )); then
  printf 'usage: %s NATIVE_ARTIFACT vMAJOR.MINOR.PATCH[-suffix]\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi

native_artifact=$1
version_tag=$2
host_os=$(go env GOHOSTOS)
host_arch=$(go env GOHOSTARCH)
if [[ "$host_os" != linux || ("$host_arch" != amd64 && "$host_arch" != arm64) ]]; then
  printf 'release verification requires a Linux amd64 or arm64 host; found %s/%s\n' "$host_os" "$host_arch" >&2
  exit 1
fi
if [[ "$native_artifact" != /* ]]; then
  native_artifact=$ROOT/$native_artifact
fi
if [[ ! -f "$native_artifact" || ! -x "$native_artifact" ]]; then
  printf 'exact native artifact is not executable: %s\n' "$native_artifact" >&2
  exit 1
fi
native_artifact=$(realpath -e -- "$native_artifact")

semver_re='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$'
if [[ ! "$version_tag" =~ $semver_re ]]; then
  printf 'verification version is not a semantic tag: %s\n' "$version_tag" >&2
  exit 2
fi
if ! git check-ref-format "refs/tags/$version_tag" >/dev/null; then
  printf 'verification version is not a valid Git tag ref: %s\n' "$version_tag" >&2
  exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/herdr-web-client-release-verify.XXXXXX")
cleanup() {
  rm -rf -- "$work"
}
trap cleanup EXIT

verify_build_settings() {
  local binary=$1
  local arch=$2
  local metadata
  metadata=$(go version -m "$binary")
  for setting in "GOOS=linux" "GOARCH=$arch" "CGO_ENABLED=0"; do
    if [[ "$metadata" != *$'\tbuild\t'"$setting"* ]]; then
      printf '%s lacks required build setting %s:\n%s\n' "$binary" "$setting" "$metadata" >&2
      exit 1
    fi
  done
}

verify_build_settings "$native_artifact" "$host_arch"
if [[ "$("$native_artifact" --version)" != "$version_tag" ]]; then
  printf '%s artifact does not report version %s\n' "$host_arch" "$version_tag" >&2
  exit 1
fi
set +e
invalid_output=$("$native_artifact" unexpected-argument 2>&1)
invalid_status=$?
set -e
if [[ "$invalid_status" != 2 || "$invalid_output" != "usage: herdr-web-client [--version]" ]]; then
  printf 'invalid CLI argument returned status %s and output %q\n' "$invalid_status" "$invalid_output" >&2
  exit 1
fi

native_repeat=$work/herdr-web-client-linux-"$host_arch"-repeat
HERDR_WEB_CLIENT_VERSION=$version_tag \
GOOS=linux GOARCH=$host_arch CGO_ENABLED=0 \
  "$ROOT/scripts/build" "$native_repeat"
if ! cmp -s -- "$native_artifact" "$native_repeat"; then
  printf 'repeated %s production build changed artifact bytes\n' "$host_arch" >&2
  exit 1
fi

if [[ "$host_arch" == amd64 ]]; then
  other_arch=arm64
  amd64_artifact=$native_artifact
else
  other_arch=amd64
  arm64_artifact=$native_artifact
fi
other_artifact=$work/herdr-web-client-linux-"$other_arch"
HERDR_WEB_CLIENT_VERSION=$version_tag \
GOOS=linux GOARCH=$other_arch CGO_ENABLED=0 \
  "$ROOT/scripts/build" "$other_artifact"
verify_build_settings "$other_artifact" "$other_arch"
other_repeat=$work/herdr-web-client-linux-"$other_arch"-repeat
HERDR_WEB_CLIENT_VERSION=$version_tag \
GOOS=linux GOARCH=$other_arch CGO_ENABLED=0 \
  "$ROOT/scripts/build" "$other_repeat"
if ! cmp -s -- "$other_artifact" "$other_repeat"; then
  printf 'repeated %s production build changed artifact bytes\n' "$other_arch" >&2
  exit 1
fi
if [[ "$other_arch" == amd64 ]]; then
  amd64_artifact=$other_artifact
else
  arm64_artifact=$other_artifact
fi
if cmp -s -- "$amd64_artifact" "$arm64_artifact"; then
  printf 'amd64 and arm64 artifacts unexpectedly have identical bytes\n' >&2
  exit 1
fi

release_dir=$work/release
mkdir -- "$release_dir"
"$ROOT/scripts/package-release" "$version_tag" "$amd64_artifact" "$arm64_artifact" "$release_dir"

swap_dir=$work/swapped-architecture
mkdir -- "$swap_dir"
if "$ROOT/scripts/package-release" "$version_tag" "$arm64_artifact" "$amd64_artifact" "$swap_dir" \
  >"$work/swapped-architecture.log" 2>&1; then
  printf 'package-release accepted architecture-swapped inputs\n' >&2
  exit 1
fi
if [[ -n $(compgen -G "$swap_dir/*" || true) ]]; then
  printf 'failed architecture preflight left release outputs behind\n' >&2
  exit 1
fi

original_output_hashes=$(
  cd -- "$release_dir"
  sha256sum -- *
)
if "$ROOT/scripts/package-release" "$version_tag" "$amd64_artifact" "$arm64_artifact" "$release_dir" \
  >"$work/duplicate-output.log" 2>&1; then
  printf 'package-release overwrote an existing output set\n' >&2
  exit 1
fi
current_output_hashes=$(
  cd -- "$release_dir"
  sha256sum -- *
)
if [[ "$current_output_hashes" != "$original_output_hashes" ]]; then
  printf 'failed output preflight modified the existing release set\n' >&2
  exit 1
fi

for invalid_tag in v1.2.3-01 v1.2.3-foo.lock; do
  if "$ROOT/scripts/package-release" "$invalid_tag" "$amd64_artifact" "$arm64_artifact" "$work/invalid-tag" \
    >"$work/invalid-tag.log" 2>&1; then
    printf 'package-release accepted invalid release tag %s\n' "$invalid_tag" >&2
    exit 1
  fi
done
(
  cd -- "$release_dir"
  sha256sum --check --strict SHA256SUMS
)

version=${version_tag#v}
for arch in amd64 arm64; do
  archive=$release_dir/herdr-web-client_${version}_linux_${arch}.tar.gz
  extract=$work/extract-$arch
  root=herdr-web-client_${version}_linux_${arch}
  mkdir -- "$extract"
  tar -xzf "$archive" -C "$extract"
  test -x "$extract/$root/herdr-web-client"
  test -f "$extract/$root/herdr-web-client.service"
  test -f "$extract/$root/.env.example"
  test -f "$extract/$root/MANIFEST.txt"
  test -f "$extract/$root/LICENSE"
  test -f "$extract/$root/THIRD_PARTY_NOTICES.md"
  license_dir=$extract/$root/LICENSES
  test -d "$license_dir"
  for module_prefix in \
    github.com__coreos__go-oidc__v3 \
    github.com__creack__pty \
    github.com__go-jose__go-jose__v4 \
    github.com__gorilla__websocket \
    golang.org__x__oauth2 \
    golang.org__x__sys \
    golang.org__x__term; do
    module_licenses=("$license_dir/${module_prefix}"@*-LICENSE*)
    if [[ ${#module_licenses[@]} != 1 || ! -s ${module_licenses[0]} ]]; then
      printf 'archive lacks the exact license for linked module %s\n' "$module_prefix" >&2
      exit 1
    fi
  done
  coreos_notices=("$license_dir"/github.com__coreos__go-oidc__v3@*-NOTICE*)
  if [[ ${#coreos_notices[@]} != 1 || ! -s ${coreos_notices[0]} ]]; then
    printf 'archive lacks the upstream CoreOS notice\n' >&2
    exit 1
  fi
  for module_prefix in golang.org__x__sys golang.org__x__term; do
    module_patents=("$license_dir/${module_prefix}"@*-PATENTS*)
    if [[ ${#module_patents[@]} != 1 || ! -s ${module_patents[0]} ]]; then
      printf 'archive lacks patent terms for linked module %s\n' "$module_prefix" >&2
      exit 1
    fi
  done
  go_licenses=("$license_dir"/Go-go*-LICENSE)
  go_patents=("$license_dir"/Go-go*-PATENTS)
  if [[ ${#go_licenses[@]} != 1 || ! -s ${go_licenses[0]} ||
        ${#go_patents[@]} != 1 || ! -s ${go_patents[0]} ]]; then
    printf 'archive lacks versioned Go runtime license or patent terms\n' >&2
    exit 1
  fi
  if [[ "$arch" == amd64 ]]; then
    cmp -s -- "$amd64_artifact" "$extract/$root/herdr-web-client"
  else
    cmp -s -- "$arm64_artifact" "$extract/$root/herdr-web-client"
  fi
  if [[ "$arch" == "$host_arch" ]]; then
    [[ "$("$extract/$root/herdr-web-client" --version)" == "$version_tag" ]]
  fi
done

sandbox=$work/install-root
install -d -m 0755 -- "$sandbox/.local/bin" "$sandbox/.config/systemd/user"
native_root=$work/extract-$host_arch/herdr-web-client_${version}_linux_${host_arch}
install -m 0755 -- "$native_root/herdr-web-client" "$sandbox/.local/bin/herdr-web-client"
install -m 0644 -- "$native_root/herdr-web-client.service" "$sandbox/.config/systemd/user/herdr-web-client.service"
cmp -s -- "$native_artifact" "$sandbox/.local/bin/herdr-web-client"
cmp -s -- "$ROOT/deploy/herdr-web-client.service" "$sandbox/.config/systemd/user/herdr-web-client.service"
[[ "$(stat -c '%a' "$sandbox/.local/bin/herdr-web-client")" == 755 ]]
[[ "$(stat -c '%a' "$sandbox/.config/systemd/user/herdr-web-client.service")" == 644 ]]

printf 'release archives, platform metadata, checksums, and sandbox installation verified\n'
