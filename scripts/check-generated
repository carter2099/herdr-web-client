#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

if (( $# != 0 )); then
  printf 'usage: %s\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi

cd -- "$ROOT"

temporary_dist=$(mktemp -d)
trap 'rm -rf -- "$temporary_dist"' EXIT

HERDR_WEB_CLIENT_BUILD_DIST=$temporary_dist bun run build.mjs >/dev/null

if ! difference=$(diff -qr -- web/dist "$temporary_dist"); then
  printf 'web/dist differs from a fresh deterministic build:\n%s\n' "$difference" >&2
  exit 1
fi

printf 'web/dist matches a fresh deterministic build\n'
