#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
BUILD_SCRIPT=$ROOT/scripts/build
host_os=$(go env GOHOSTOS)
host_arch=$(go env GOHOSTARCH)
if [[ "$host_os" != linux || ("$host_arch" != amd64 && "$host_arch" != arm64) ]]; then
  printf 'verify-browser requires a Linux amd64 or arm64 host; found %s/%s\n' "$host_os" "$host_arch" >&2
  exit 1
fi

usage() {
  printf 'usage: %s [artifact] [playwright test options...]\n' "${BASH_SOURCE[0]}" >&2
}

artifact=''
if (( $# > 0 )) && [[ "$1" != -* ]]; then
  artifact=$1
  shift
else
  artifact=$ROOT/build/herdr-web-client
  GOOS=linux GOARCH=$host_arch CGO_ENABLED=0 "$BUILD_SCRIPT" "$artifact"
fi

if [[ "$artifact" != /* ]]; then
  artifact=$ROOT/$artifact
fi
if [[ ! -f "$artifact" || ! -x "$artifact" ]]; then
  printf 'verify-browser: exact executable artifact is required: %s\n' "$artifact" >&2
  usage
  exit 2
fi
artifact=$(realpath -e -- "$artifact")
metadata=$(go version -m "$artifact")
for setting in "GOOS=linux" "GOARCH=$host_arch" "CGO_ENABLED=0"; do
  if [[ "$metadata" != *$'\tbuild\t'"$setting"* ]]; then
    printf 'verify-browser: artifact is not a native Linux %s build (%s missing)\n' "$host_arch" "$setting" >&2
    exit 2
  fi
done

playwright=$ROOT/node_modules/.bin/playwright
if [[ ! -x "$playwright" ]]; then
  printf 'verify-browser: Playwright is not installed locally; run the repository package manager explicitly\n' >&2
  exit 2
fi

fixture_parent=${TMPDIR:-/tmp}
if [[ "${HERDR_E2E_SYSTEMD:-}" == 1 ]]; then
  if [[ -z "${INVOCATION_ID:-}" || -z "${XDG_RUNTIME_DIR:-}" ]]; then
    printf '%s\n' 'verify-browser: HERDR_E2E_SYSTEMD=1 requires a live systemd user service' >&2
    exit 2
  fi
  fixture_parent=${HOME:?}/.config/herdr
  if [[ ! -d "$fixture_parent" || ! -w "$fixture_parent" ]]; then
    printf 'verify-browser: supported-mode fixture directory is unavailable: %s\n' "$fixture_parent" >&2
    exit 2
  fi
fi
fixture_dir=$(mktemp -d "$fixture_parent/.hwc-e2e.XXXXXX")
export TMPDIR=$fixture_dir
fixture=$fixture_dir/herdr-web-client-testfixture
cleanup() {
  rm -rf -- "$fixture_dir"
}
trap cleanup EXIT

cd -- "$ROOT"
GOOS=linux GOARCH=$host_arch CGO_ENABLED=0 \
  go build -trimpath -buildvcs=false -o "$fixture" ./cmd/herdr-web-client-testfixture
for project in chromium-desktop chromium-mobile; do
  HERDR_WEB_CLIENT_EXPECTED_PROJECT=$project \
  HERDR_WEB_CLIENT_ARTIFACT=$artifact \
  HERDR_WEB_CLIENT_DIST=$ROOT/web/dist \
  HERDR_WEB_CLIENT_FIXTURE=$fixture \
    "$playwright" test --project="$project" "$@"
done
